NODE_ENV=development
PORT=4000
DATABASE_URL="mysql://devflow:devflow@localhost:3306/devflow_ai"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=12h
JWT_REFRESH_EXPIRES=30d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
FRONTEND_URL=http://localhost:5174

# Create at https://github.com/settings/developers → OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/integrations/github/callback
GITHUB_WEBHOOK_SECRET=

# Free Google Gemini (preferred when set) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI-compatible LLM (Ollama, Groq, OpenRouter, etc.)
# Used only when GEMINI_API_KEY is empty.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama3.2
